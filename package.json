  "scripts": {
    "termux:dev": "next dev --webpack",
    "termux:build": "next build --webpack",
    "build": "next build && serwist build",
    "check": "ultracite check",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "dev:https": "next dev --turbo --experimental-https",
    "dev:https:lan": "node scripts/dev-lan.mjs",
    "dev:https:lan:sw": "node scripts/dev-lan.mjs --sw",
    "postinstall": "prisma generate",
    "preview": "next build && next start",
    "pwa:assets": "node scripts/pwa-assets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "fix": "ultracite fix",
    "test": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "validate": "npm run typecheck && npm run check:write && npm run test:all && npm run build"
  },
